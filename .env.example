SERVICE_NAME=Payment Gateway Service
SERVICE_DESCRIPTION=Simulates a real-world payment processing system
SERVICE_VERSION=1.0.0
DEBUG=True

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5435/payment_service

REDIS_URL=redis://localhost:6382/0

API_CLIENT_KEY=P1234
MAX_RETRIES=3
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=30.0

GATEWAY_SUCCESS_RATE=0.65
GATEWAY_TIMEOUT_RATE=0.10
GATEWAY_DELAY_MIN=0.2
GATEWAY_DELAY_MAX=1.5
GATEWAY_TIMEOUT_SECONDS=5.0

CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT=30.0

RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60
